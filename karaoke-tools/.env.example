# karaoke-tools environment variables.
# Hermes passes these via the `env:` block in config.yaml; this file is only
# a reference (the server does not load .env itself). Export them in your
# shell when running try_tool.py or the MCP Inspector by hand.

# The repertoire repo (catalog/songs.csv, lyrics/, events/, index/, log.md).
# All wiki writes stay inside this folder.
WIKI_ROOT=~/.hermes/profiles/karaoke-gayak/karaoke-gayak-wiki

# Your local MP3 folder. Read-only: scan_folder and analyze_audio only.
# Unset = scan_folder is disabled.
# SEED_ROOT=~/Music/Karaoke

# Temp downloads (MEDIA_ROOT/<job_id>/audio.mp3). Created on startup.
MEDIA_ROOT=~/.hermes/profiles/karaoke-gayak/media-tmp

# Preferred karaoke channel: indexed by channel_index_refresh, ranked first
# by karaoke_find.
PREFERRED_CHANNEL_URL=https://www.youtube.com/@AnilChauhankaraoke

# Videos longer than this (seconds) are not downloaded. 900 = 15 minutes.
MAX_DURATION_SEC=900

# Full path to ffmpeg. Hermes runs under launchd with a minimal PATH, so a
# bare "ffmpeg" may not be found. Intel Mac Homebrew: /usr/local/bin/ffmpeg
FFMPEG_PATH=/usr/local/bin/ffmpeg

# JS runtime for YouTube's signature/n challenges, as name:path. Without one,
# yt-dlp warns "Signature solving failed" and downloads may fail. Unset = look
# for deno, then node, on PATH (which launchd's PATH usually lacks).
YTDLP_JS_RUNTIME=node:/Users/bishpaul/.local/bin/node

# Optional free Genius API client access token (genius.com/api-clients).
# Without it the public genius.com search endpoint is used.
# GENIUS_ACCESS_TOKEN=

# Extra lyrics domains for lyrics_from_url, comma-separated (subdomains included).
LYRICS_EXTRA_DOMAINS=

# Seconds between lyrics-site requests.
LYRICS_DELAY_SEC=2

# --- Suggestions and feedback buttons ---------------------------------------
# The KaraokeGayak bot token (the same bot the gateway runs). In Hermes's
# config.yaml write the placeholder "${TELEGRAM_BOT_TOKEN}": Hermes fills it in
# from the profile's .env, so the token itself never appears in config.yaml.
# The server only sends: sendMessage, setChatMenuButton (never getUpdates or a webhook).
# TELEGRAM_BOT_TOKEN=123456:ABC...

# The only chat the server may send to: Neel's Telegram user id (= the DM chat
# id). In config.yaml: "${TELEGRAM_HOME_CHANNEL}" (that's the same id in the
# karaoke-gayak profile's .env).
# TELEGRAM_CHAT_ID=123456789

# off (default): no feedback UI in the chat; likes and ratings happen in the
# Mini App (typed fb 1👍 / rate 3 9 still work). keyboard: the older per-song
# reply-keyboard buttons.
FEEDBACK_MODE=off

# Keyboard mode only. reply (default): a reply keyboard; taps arrive as normal messages.
# inline is refused: Hermes drops inline-button taps it doesn't recognise.
BUTTON_MODE=reply

# Session state (which number in the last suggestion list is which song).
# Outside the wiki repo on purpose.
STATE_ROOT=~/.hermes/profiles/karaoke-gayak/state

# --- Mini App (app/) --------------------------------------------------------------
# The app's public https address (Tailscale Funnel), used by open_app and
# setup_menu_button.py. Example: https://my-mac.tail1234.ts.net
# APP_URL=https://<machine>.<tailnet>.ts.net

# App server only (python -m app): extra env files to read, colon-separated.
# Only known keys are taken, and the process env wins. The default reads
# TELEGRAM_BOT_TOKEN (and TELEGRAM_HOME_CHANNEL as the chat id) from the
# Hermes profile's .env, so the token never goes into the launchd plist.
# KARAOKE_APP_ENV_FILES=~/.hermes/profiles/karaoke-gayak/.env
