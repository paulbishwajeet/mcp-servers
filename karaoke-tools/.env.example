# karaoke-tools environment variables.
# Hermes passes these via the `env:` block in config.yaml; this file is only
# a reference (the server does not load .env itself). Export them in your
# shell when running try_tool.py or the MCP Inspector by hand.

# The repertoire repo (catalog/songs.csv, lyrics/, events/, index/, log.md).
# All wiki writes stay inside this folder.
WIKI_ROOT=~/.hermes/profiles/karaoke-gayak/karaoke-gayak-wiki

# Your local MP3 folder. Read-only: scan_folder and analyze_audio only.
# Unset = scan_folder is disabled.
# SEED_ROOT=~/Music/Karaoke

# Temp downloads (MEDIA_ROOT/<job_id>/audio.mp3). Created on startup.
MEDIA_ROOT=~/.hermes/profiles/karaoke-gayak/media-tmp

# Preferred karaoke channel: indexed by channel_index_refresh, ranked first
# by karaoke_find.
PREFERRED_CHANNEL_URL=https://www.youtube.com/@AnilChauhankaraoke

# Videos longer than this (seconds) are not downloaded. 900 = 15 minutes.
MAX_DURATION_SEC=900

# Full path to ffmpeg. Hermes runs under launchd with a minimal PATH, so a
# bare "ffmpeg" may not be found. Intel Mac Homebrew: /usr/local/bin/ffmpeg
FFMPEG_PATH=/usr/local/bin/ffmpeg

# JS runtime for YouTube's signature/n challenges, as name:path. Without one,
# yt-dlp warns "Signature solving failed" and downloads may fail. Unset = look
# for deno, then node, on PATH (which launchd's PATH usually lacks).
YTDLP_JS_RUNTIME=node:/Users/bishpaul/.local/bin/node

# Optional free Genius API client access token (genius.com/api-clients).
# Without it the public genius.com search endpoint is used.
# GENIUS_ACCESS_TOKEN=

# Extra lyrics domains for lyrics_from_url, comma-separated (subdomains included).
LYRICS_EXTRA_DOMAINS=

# Seconds between lyrics-site requests.
LYRICS_DELAY_SEC=2
